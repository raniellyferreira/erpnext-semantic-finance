# ─── ERPNext ───────────────────────────────────────────────────────────────────
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=sua_api_key_aqui
ERPNEXT_API_SECRET=seu_api_secret_aqui
ERPNEXT_SITE_NAME=mysite.localhost
ERPNEXT_DEFAULT_COMPANY=Minha Empresa Ltda

# ─── Vector Store ──────────────────────────────────────────────────────────────
# Opções: qdrant | pinecone
VECTOR_STORE_PROVIDER=qdrant

# Dimensão do vetor — deve bater com o modelo de embedding escolhido:
#   768  → nomic-embed-text (Ollama)
#   1536 → text-embedding-3-small (OpenAI)
#   2048 → voyage-3-large (Voyage AI)
EMBEDDING_DIMENSION=768

# ─── Qdrant (self-hosted ou Qdrant Cloud) ──────────────────────────────────────
# Deixe QDRANT_API_KEY vazio para instâncias locais sem autenticação
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Pinecone ──────────────────────────────────────────────────────────────────
# Obtenha sua API Key em: https://app.pinecone.io
PINECONE_API_KEY=
# Nome do index já criado no console Pinecone (deve ter metric=cosine)
PINECONE_INDEX_NAME=erpnext-finance
# Namespace base (útil para multi-tenancy / múltiplas empresas)
PINECONE_NAMESPACE=default
# Ambiente legado (pod-based). Deixe vazio para Pinecone Serverless (recomendado)
PINECONE_ENVIRONMENT=

# ─── Embeddings ────────────────────────────────────────────────────────────────
# Opções: ollama | openai | voyage
EMBEDDING_PROVIDER=ollama

# Ollama — 100% local, dados financeiros não saem da infraestrutura (recomendado)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI — maior qualidade, mas dados enviados para API externa (atenção à LGPD)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI — modelos de alta qualidade com API compatível, URL configurável
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-large
# URL base da API (permite self-hosting ou proxy)
VOYAGE_API_URL=https://api.voyageai.com

# ─── Focus NF-e ────────────────────────────────────────────────────────────────
# Obtenha token em: https://focusnfe.com.br
FOCUS_NFE_TOKEN=seu_token_focus_nfe
# Opções: homologacao | producao
FOCUS_NFE_ENVIRONMENT=homologacao
FOCUS_NFE_URL_HOMOLOGACAO=https://homologacao.focusnfe.com.br
FOCUS_NFE_URL_PRODUCAO=https://api.focusnfe.com.br

# ─── MCP Server ────────────────────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
LOG_LEVEL=INFO

# ─── MySQL/MariaDB ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=secret
